{
  "name": "@masareef/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript shared by the web app and the API: category and currency lists, digit and money conversion, amount and date formatters, utterance parser",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "masareef-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "i18n:check": "tsx scripts/check-translations.js"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
