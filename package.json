{
  "name": "masareef",
  "version": "0.0.0",
  "private": true,
  "description": "Masareef: voice-first personal expense tracker (monorepo root)",
  "type": "module",
  "engines": {
    "node": "^26.13.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "poc/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project apps/api/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "audit": "npm audit --json | node scripts/audit.js",
    "voice:validate": "npm run build && npm run validate --workspace @masareef/poc-voice",
    "voice:score": "npm run build && npm run score --workspace @masareef/poc-voice"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
