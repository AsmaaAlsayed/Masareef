{
  "components": {
    "parameters": {},
    "schemas": {
      "Config": {
        "additionalProperties": false,
        "properties": {
          "googleClientId": {
            "description": "Google's public OAuth web client id; null while Google sign-in is not set up",
            "type": ["string", "null"]
          },
          "privacyVersion": {
            "description": "Current version of the privacy policy",
            "type": "string"
          },
          "release": {
            "description": "The running build (commit SHA once deployed)",
            "type": "string"
          },
          "termsVersion": {
            "description": "Current version of the terms",
            "type": "string"
          }
        },
        "required": ["googleClientId", "termsVersion", "privacyVersion", "release"],
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details. `code` is stable and is what the client translates; `request_id` matches the X-Request-Id header.",
        "properties": {
          "code": {
            "enum": [
              "validation_failed",
              "unauthenticated",
              "not_found",
              "too_large",
              "internal",
              "not_ready"
            ],
            "type": "string"
          },
          "errors": {
            "description": "Present for validation_failed: one entry per rejected field.",
            "items": {
              "properties": {
                "code": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                }
              },
              "required": ["field", "code"],
              "type": "object"
            },
            "type": "array"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "code", "request_id"],
        "type": "object"
      },
      "Status": {
        "properties": {
          "status": {
            "enum": ["ok"],
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Generated from the route schemas in apps/api by `npm run openapi:generate`. Do not edit by hand.",
    "title": "Masareef API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/config": {
      "get": {
        "operationId": "getConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            },
            "description": "The public configuration"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error (internal: an unexpected failure or incomplete configuration)"
          }
        },
        "summary": "Public settings for the clients",
        "tags": ["config"]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Alive"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error (internal: an unexpected failure or incomplete configuration)"
          }
        },
        "summary": "The Worker answers",
        "tags": ["health"]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Ready"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error (internal: an unexpected failure or incomplete configuration)"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable (not_ready: a dependency is unavailable)"
          }
        },
        "summary": "A SELECT 1 on the database succeeds within 2 seconds",
        "tags": ["health"]
      }
    }
  },
  "webhooks": {}
}
